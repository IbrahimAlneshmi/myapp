		}
	}

	internal void SetLicenseSnapshot(LicenseSnapshot snapshot)
	{
		if (base.InvokeRequired)
		{
			Invoke(delegate
			{
				SetLicenseSnapshot(snapshot);
			});
			return;
		}
		string text = (snapshot.CanUseOverlay ? "Status: Activated" : (snapshot.IsActivated ? "Status: Locked" : "Status: Not activated"));
		_licenseStatusLabel.Text = text;
		_licenseStatusLabel.ForeColor = (snapshot.CanUseOverlay ? ColGreen : (snapshot.IsActivated ? ColYellow : ColRed));
		string value = (string.IsNullOrWhiteSpace(snapshot.DisplayName) ? string.Empty : (" (" + snapshot.DisplayName + ")"));
		_licenseQuotaLabel.Text = $"Remaining: {snapshot.RemainingQuestions}{value}";
		_licenseQuotaLabel.ForeColor = ((snapshot.RemainingQuestions > 0) ? ColGreen : ColYellow);
		_licenseWindowLabel.Text = "Window: " + FormatLicenseWindow(snapshot);
		_licenseWindowLabel.ForeColor = (snapshot.AllowedNow ? ColGreen : ColTextDim);
		string hardwareId = snapshot.HardwareId;
		_licenseHardwareLabel.Text = (string.IsNullOrWhiteSpace(hardwareId) ? "HWID: unavailable" : ("HWID: " + hardwareId.Substring(0, Math.Min(12, hardwareId.Length))));
	}

	private static string FormatLicenseWindow(LicenseSnapshot snapshot)
	{
		if (!snapshot.WindowStart.HasValue || !snapshot.WindowEnd.HasValue)
		{
			if (!snapshot.AllowedNow)
			{
				return "Locked";
			}
			return "Open";
		}
		return $"{snapshot.WindowStart.Value.LocalDateTime:HH:mm} - {snapshot.WindowEnd.Value.LocalDateTime:HH:mm}";
	}

	private string BuildStatusText()
	{
		TimeSpan timeSpan = DateTime.Now - _startTime;
		string value = $"{(int)timeSpan.TotalHours:D2}:{timeSpan.Minutes:D2}:{timeSpan.Seconds:D2}";
		return $"  PID: {Process.GetCurrentProcess().Id}   │   Hooks: {_hookCount}   │   Ghost Procs: {_ghostProcessCount}   │   Uptime: {value}   │   Status: STANDBY";
	}

	private Panel CreateBorderedPanel(Point location, Size size, string header, Color borderColor)
	{
		DoubleBufferedPanel panel = new DoubleBufferedPanel
		{
			Location = location,
			Size = size,
			BackColor = ColPanel
		};
		panel.Paint += delegate(object? s, PaintEventArgs e)
		{
			Graphics graphics = e.Graphics;
			graphics.SmoothingMode = SmoothingMode.AntiAlias;
			using Pen pen = new Pen(Color.FromArgb(30, borderColor), 3f);
			graphics.DrawRectangle(pen, 1, 1, panel.Width - 3, panel.Height - 3);
			using Pen pen2 = new Pen(borderColor, 1.2f);
			graphics.DrawRectangle(pen2, 0, 0, panel.Width - 1, panel.Height - 1);
			using Font font = new Font("Consolas", 8f, FontStyle.Bold);
			using SolidBrush brush = new SolidBrush(borderColor);
			SizeF sizeF = graphics.MeasureString(header, font);
			RectangleF rect = new RectangleF(12f, 3f, sizeF.Width + 8f, sizeF.Height + 2f);
			using SolidBrush brush2 = new SolidBrush(ColPanel);
			graphics.FillRectangle(brush2, rect);
			graphics.DrawString(" " + header + " ", font, brush, 14f, 4f);
		};
		return panel;
	}

