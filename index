	private class StatusIndicator : Control
	{
		private static readonly Font TagFont = new Font("Consolas", 9.5f, FontStyle.Bold);

		private static readonly Font DescFont = new Font("Consolas", 9.5f, FontStyle.Regular);

		[DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
		public string LayerTag { get; }

		[DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
		public string Description { get; }

		[DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
		public bool IsActive { get; set; }

		public StatusIndicator(string tag, string description, bool active)
		{
			LayerTag = tag;
			Description = description;
			IsActive = active;
			DoubleBuffered = true;
			SetStyle(ControlStyles.UserPaint | ControlStyles.ResizeRedraw | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, value: true);
		}

		protected override void OnPaint(PaintEventArgs e)
		{
			Graphics graphics = e.Graphics;
			graphics.SmoothingMode = SmoothingMode.AntiAlias;
			graphics.Clear(ColPanel);
			int num = 12;
			int num2 = (base.Height - num) / 2;
			Color color = (IsActive ? ColGreen : ColGray);
			Color color2 = (IsActive ? Color.FromArgb(60, 0, 255, 65) : Color.Transparent);
			if (IsActive)
			{
				using SolidBrush brush = new SolidBrush(color2);
				graphics.FillEllipse(brush, -2, num2 - 2, num + 4, num + 4);
			}
			using SolidBrush brush2 = new SolidBrush(color);
			graphics.FillEllipse(brush2, 0, num2, num, num);
			using Pen pen = new Pen(Color.FromArgb(IsActive ? 180 : 60, color), 1f);
			graphics.DrawEllipse(pen, 0, num2, num, num);
			float num3 = num + 10;
			using SolidBrush brush3 = new SolidBrush(IsActive ? ColCyan : ColGray);
			graphics.DrawString("[" + LayerTag + "]", TagFont, brush3, num3, (float)(base.Height - TagFont.Height) / 2f);
			float x = num3 + graphics.MeasureString("[" + LayerTag + "]", TagFont).Width + 6f;
			using SolidBrush brush4 = new SolidBrush(IsActive ? ColGreen : ColTextDim);
			graphics.DrawString(Description, DescFont, brush4, x, (float)(base.Height - DescFont.Height) / 2f);
			string text = (IsActive ? "● ACTIVE" : "○ INACTIVE");
			Color color3 = (IsActive ? ColGreen : ColGray);
			using Font font = new Font("Consolas", 8.5f, FontStyle.Bold);
			SizeF sizeF = graphics.MeasureString(text, font);
			using SolidBrush brush5 = new SolidBrush(color3);
			graphics.DrawString(text, font, brush5, (float)base.Width - sizeF.Width - 10f, (float)(base.Height - font.Height) / 2f);
		}
	}

	private class GhostButton : Control
	{
		private bool _isHovered;

		private bool _isPressed;

		[DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
		public Color BorderColor { get; set; } = ColGreen;

		[DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
		public Color HoverBorderColor { get; set; } = Color.FromArgb(100, 255, 130);

		public GhostButton()
		{
			DoubleBuffered = true;
			SetStyle(ControlStyles.UserPaint | ControlStyles.ResizeRedraw | ControlStyles.Selectable | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, value: true);
			Cursor = Cursors.Hand;
			base.Size = new Size(200, 50);
			ForeColor = Color.White;
		}

		protected override void OnMouseEnter(EventArgs e)
		{
			_isHovered = true;
			Invalidate();
			base.OnMouseEnter(e);
		}

		protected override void OnMouseLeave(EventArgs e)
		{
			_isHovered = false;
			_isPressed = false;
			Invalidate();
			base.OnMouseLeave(e);
		}

		protected override void OnMouseDown(MouseEventArgs e)
		{
			_isPressed = true;
			Invalidate();
			base.OnMouseDown(e);
		}

		protected override void OnMouseUp(MouseEventArgs e)
		{
			_isPressed = false;
			Invalidate();
			base.OnMouseUp(e);
		}

		protected override void OnPaint(PaintEventArgs e)
		{
			Graphics graphics = e.Graphics;
			graphics.SmoothingMode = SmoothingMode.AntiAlias;
			graphics.TextRenderingHint = TextRenderingHint.ClearTypeGridFit;
			Rectangle rect = new Rectangle(0, 0, base.Width - 1, base.Height - 1);
			int num = 6;
			Color color = (_isPressed ? Color.FromArgb(45, 45, 45) : ((!_isHovered) ? Color.FromArgb(18, 18, 18) : Color.FromArgb(35, 35, 35)));
			using GraphicsPath path = CreateRoundedRectPath(rect, num);
			using SolidBrush brush = new SolidBrush(color);
			graphics.FillPath(brush, path);
			if (_isHovered)
			{
				using Pen pen = new Pen(Color.FromArgb(25, BorderColor), 5f);
				graphics.DrawPath(pen, path);
			}
			Color color2 = (_isHovered ? HoverBorderColor : BorderColor);
			float width = (_isHovered ? 2f : 1.2f);
			using Pen pen2 = new Pen(color2, width);
			graphics.DrawPath(pen2, path);
			if (_isHovered)
			{
				using Pen pen3 = new Pen(Color.FromArgb(20, 255, 255, 255), 1f);
				graphics.DrawLine(pen3, num, 1, base.Width - num - 1, 1);
			}
			using SolidBrush brush2 = new SolidBrush(_isHovered ? Color.FromArgb(255, color2.R, color2.G, color2.B) : color2);
			using StringFormat format = new StringFormat
			{
				Alignment = StringAlignment.Center,
				LineAlignment = StringAlignment.Center
			};
			graphics.DrawString(Text, Font, brush2, new RectangleF(0f, 0f, base.Width, base.Height), format);
		}

		private static GraphicsPath CreateRoundedRectPath(Rectangle rect, int radius)
		{
			GraphicsPath graphicsPath = new GraphicsPath();
			int num = radius * 2;
			graphicsPath.AddArc(rect.X, rect.Y, num, num, 180f, 90f);
			graphicsPath.AddArc(rect.Right - num, rect.Y, num, num, 270f, 90f);
			graphicsPath.AddArc(rect.Right - num, rect.Bottom - num, num, num, 0f, 90f);
			graphicsPath.AddArc(rect.X, rect.Bottom - num, num, num, 90f, 90f);
			graphicsPath.CloseFigure();
			return graphicsPath;
		}
	}

